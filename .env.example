# ── App ────────────────────────────────────────────────────────────────
APP_ENV=production                # local | dev | staging | pilot | production
PORT=80
ROOT_PATH=/colombia-unida/api     # subpath público detrás de nginx/Traefik
LOG_LEVEL=INFO

# ── Base de datos (PostgreSQL + PostGIS) ───────────────────────────────
DATABASE_URL=postgresql+psycopg://colombia_unida:CHANGE_ME@colombia-unida_db:5432/colombia_unida

# ── Seguridad ──────────────────────────────────────────────────────────
# Clave de cifrado de aplicación para campos PRIV/SENS (32 bytes base64)
APP_ENCRYPTION_KEY=
# Clave HMAC para índices de búsqueda de teléfono/email (32 bytes base64)
APP_HMAC_KEY=
# Clave privada Ed25519 (base64) para firmar manifiestos de auditoría
AUDIT_SIGNING_KEY=
# Secreto para JWT de sesión de la consola
JWT_SECRET=

# ── Meta WhatsApp Cloud API ────────────────────────────────────────────
META_GRAPH_API_VERSION=v23.0
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=                # token de system user, mínimo privilegio
META_APP_SECRET=                  # para verificar X-Hub-Signature-256
META_WEBHOOK_VERIFY_TOKEN=        # challenge de verificación del webhook

# ── IA ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
STT_PROVIDER=openai               # openai | disabled
OPENAI_API_KEY=                   # para Whisper STT

# ── Almacenamiento de objetos (MinIO / S3-compatible) ──────────────────
S3_ENDPOINT_URL=http://colombia-unida_minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_QUARANTINE=quarantine
S3_BUCKET_PROTECTED=protected
S3_BUCKET_PUBLIC=public
S3_BUCKET_AUDIT=audit

# ── ClamAV ─────────────────────────────────────────────────────────────
CLAMAV_HOST=colombia-unida_clamav
CLAMAV_PORT=3310

# ── n8n (alertas y conectores no críticos) ─────────────────────────────
N8N_WEBHOOK_BASE_URL=
